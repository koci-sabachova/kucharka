# Service worker must always be fresh — never cache.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Recipe data is regenerated by the sync workflow; serve the latest.
# Access-Control-Allow-Origin lets the Robuchon-embedded copy of this app
# fetch it live cross-origin instead of keeping its own stale snapshot.
/data/recipes.json
  Cache-Control: no-cache, no-store, must-revalidate
  Access-Control-Allow-Origin: *

/data/lahve_db.json
  Access-Control-Allow-Origin: *
